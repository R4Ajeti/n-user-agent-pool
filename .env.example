ENVIRONMENT_PATH=env/bin/activate # Local Python virtual-environment activation script path.
DEBUGGING= # Optional true or false shortcut; when set, it takes precedence over LOGGER.
LOGGER= # Optional Python log level name or number; leave blank to disable package logging.
KEY_VAL_BASE_URL= # Optional Keyval-compatible base URL; leave blank to keep persistence local.
KEY_VAL_AUTH_TOKEN= # Optional bearer token for a private Keyval-compatible provider.
USER_AGENT_POOL_NAMESPACE= # Recommended unique namespace when using the public KeyVal provider.
USER_AGENT_HISTORY_BACKEND=memory # Supported values: memory, keyval, firebase_realtime_database, or firebase_firestore.
FIREBASE_REALTIME_DATABASE_URL= # Required only when USER_AGENT_HISTORY_BACKEND is firebase_realtime_database.
FIREBASE_REALTIME_DATABASE_CREDENTIAL_BASE64= # Base64-encoded JSON credential for Firebase Realtime Database.
FIREBASE_FIRESTORE_PROJECT_ID= # Required only when USER_AGENT_HISTORY_BACKEND is firebase_firestore.
FIREBASE_FIRESTORE_CREDENTIAL_BASE64= # Base64-encoded JSON credential for Firestore.
